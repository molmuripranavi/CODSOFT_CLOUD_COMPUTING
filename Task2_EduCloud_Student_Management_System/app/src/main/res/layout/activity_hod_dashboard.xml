<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FC"
    tools:context=".activities.HodDashboardActivity">


    <!-- ============================= -->
    <!-- MAIN SCROLL VIEW -->
    <!-- ============================= -->

    <androidx.core.widget.NestedScrollView

        android:id="@+id/scrollView"

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:fillViewport="true"

        android:clipToPadding="false"

        android:paddingBottom="20dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnLogout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical">


            <!-- ============================= -->
            <!-- BLUE HEADER -->
            <!-- ============================= -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:gravity="center"

                android:background="#1565C0"

                android:paddingTop="28dp"
                android:paddingBottom="32dp">


                <!-- EduCloud Logo -->

                <ImageView

                    android:id="@+id/imgLogo"

                    android:layout_width="150dp"
                    android:layout_height="150dp"

                    android:src="@drawable/educloud_logo"

                    android:scaleType="fitCenter"

                    android:contentDescription="EduCloud Logo" />


                <!-- EduCloud -->

                <TextView

                    android:id="@+id/txtAppName"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="EduCloud"

                    android:textColor="@android:color/white"

                    android:textSize="38sp"

                    android:textStyle="bold" />


                <!-- Portal -->

                <TextView

                    android:id="@+id/txtPortal"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:text="HOD Portal"

                    android:textColor="@android:color/white"

                    android:textSize="27sp"

                    android:textStyle="bold" />


                <!-- HOD Email -->

                <TextView

                    android:id="@+id/txtHodEmail"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="14dp"

                    android:text="hod@gmail.com"

                    android:textColor="@android:color/white"

                    android:textSize="18sp" />

            </LinearLayout>


            <!-- ============================= -->
            <!-- CONTENT -->
            <!-- ============================= -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="28dp"
                android:paddingBottom="30dp">


                <!-- ============================= -->
                <!-- LEAVES STATISTICS -->
                <!-- ============================= -->

                <TextView

                    android:id="@+id/txtLeavesStatistics"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Leaves Statistics"

                    android:textColor="#1565C0"

                    android:textSize="28sp"

                    android:textStyle="bold" />


                <!-- Statistics Row -->

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="22dp"

                    android:orientation="horizontal"

                    android:weightSum="3">


                    <!-- Pending -->

                    <com.google.android.material.card.MaterialCardView

                        android:id="@+id/cardPending"

                        android:layout_width="0dp"
                        android:layout_height="145dp"

                        android:layout_weight="1"

                        android:layout_marginEnd="8dp"

                        app:cardBackgroundColor="#F0EAF4"

                        app:cardCornerRadius="25dp"

                        app:cardElevation="7dp"

                        app:strokeColor="#D8CEDD"

                        app:strokeWidth="1dp">


                        <LinearLayout

                            android:layout_width="match_parent"
                            android:layout_height="match_parent"

                            android:gravity="center"

                            android:orientation="vertical">


                            <TextView

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="Pending"

                                android:textColor="#4E4A50"

                                android:textSize="18sp"

                                android:textStyle="bold" />


                            <TextView

                                android:id="@+id/txtPendingCount"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="8dp"

                                android:text="0"

                                android:textColor="#F57C00"

                                android:textSize="40sp"

                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- Approved -->

                    <com.google.android.material.card.MaterialCardView

                        android:id="@+id/cardApproved"

                        android:layout_width="0dp"
                        android:layout_height="145dp"

                        android:layout_weight="1"

                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"

                        app:cardBackgroundColor="#F0EAF4"

                        app:cardCornerRadius="25dp"

                        app:cardElevation="7dp"

                        app:strokeColor="#D8CEDD"

                        app:strokeWidth="1dp">


                        <LinearLayout

                            android:layout_width="match_parent"
                            android:layout_height="match_parent"

                            android:gravity="center"

                            android:orientation="vertical">


                            <TextView

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="Approved"

                                android:textColor="#4E4A50"

                                android:textSize="18sp"

                                android:textStyle="bold" />


                            <TextView

                                android:id="@+id/txtApprovedCount"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="8dp"

                                android:text="0"

                                android:textColor="#388E3C"

                                android:textSize="40sp"

                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- Rejected -->

                    <com.google.android.material.card.MaterialCardView

                        android:id="@+id/cardRejected"

                        android:layout_width="0dp"
                        android:layout_height="145dp"

                        android:layout_weight="1"

                        android:layout_marginStart="8dp"

                        app:cardBackgroundColor="#F0EAF4"

                        app:cardCornerRadius="25dp"

                        app:cardElevation="7dp"

                        app:strokeColor="#D8CEDD"

                        app:strokeWidth="1dp">


                        <LinearLayout

                            android:layout_width="match_parent"
                            android:layout_height="match_parent"

                            android:gravity="center"

                            android:orientation="vertical">


                            <TextView

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="Rejected"

                                android:textColor="#4E4A50"

                                android:textSize="18sp"

                                android:textStyle="bold" />


                            <TextView

                                android:id="@+id/txtRejectedCount"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="8dp"

                                android:text="0"

                                android:textColor="#D32F2F"

                                android:textSize="40sp"

                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>


                <!-- ============================= -->
                <!-- ADMIN ACTIONS -->
                <!-- ============================= -->

                <TextView

                    android:id="@+id/txtAdminActions"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="52dp"

                    android:text="Admin Actions"

                    android:textColor="#1565C0"

                    android:textSize="28sp"

                    android:textStyle="bold" />


                <!-- ============================= -->
                <!-- ROW 1 -->
                <!-- ============================= -->

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="24dp"

                    android:orientation="horizontal"

                    android:weightSum="2">


                    <!-- Analytics -->

                    <com.google.android.material.card.MaterialCardView

                        android:id="@+id/cardAnalytics"

                        android:layout_width="0dp"
                        android:layout_height="190dp"

                        android:layout_weight="1"

                        android:layout_marginEnd="10dp"

                        android:clickable="true"
                        android:focusable="true"

                        android:foreground="?attr/selectableItemBackground"

                        app:cardBackgroundColor="#F0EAF4"

                        app:cardCornerRadius="28dp"

                        app:cardElevation="8dp"

                        app:strokeColor="#D8CEDD"

                        app:strokeWidth="1dp">


                        <LinearLayout

                            android:layout_width="match_parent"
                            android:layout_height="match_parent"

                            android:gravity="center"

                            android:orientation="vertical">


                            <ImageView

                                android:layout_width="70dp"
                                android:layout_height="70dp"

                                android:src="@drawable/analytics"

                                android:scaleType="centerInside"

                                android:contentDescription="Analytics" />


                            <TextView

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="14dp"

                                android:text="Analytics"

                                android:textColor="#4E4A50"

                                android:textSize="22sp"

                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- Pending -->

                    <com.google.android.material.card.MaterialCardView

                        android:id="@+id/cardPendingAction"

                        android:layout_width="0dp"
                        android:layout_height="190dp"

                        android:layout_weight="1"

                        android:layout_marginStart="10dp"

                        android:clickable="true"
                        android:focusable="true"

                        android:foreground="?attr/selectableItemBackground"

                        app:cardBackgroundColor="#F0EAF4"

                        app:cardCornerRadius="28dp"

                        app:cardElevation="8dp"

                        app:strokeColor="#D8CEDD"

                        app:strokeWidth="1dp">


                        <LinearLayout

                            android:layout_width="match_parent"
                            android:layout_height="match_parent"

                            android:gravity="center"

                            android:orientation="vertical">


                            <ImageView

                                android:layout_width="70dp"
                                android:layout_height="70dp"

                                android:src="@drawable/pending"

                                android:scaleType="centerInside"

                                android:contentDescription="Pending" />


                            <TextView

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="14dp"

                                android:text="Pending"

                                android:textColor="#4E4A50"

                                android:textSize="22sp"

                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>


                <!-- ============================= -->
                <!-- ROW 2 -->
                <!-- ============================= -->

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="22dp"

                    android:orientation="horizontal"

                    android:weightSum="2">


                    <!-- Approved -->

                    <com.google.android.material.card.MaterialCardView

                        android:id="@+id/cardApprovedAction"

                        android:layout_width="0dp"
                        android:layout_height="190dp"

                        android:layout_weight="1"

                        android:layout_marginEnd="10dp"

                        android:clickable="true"
                        android:focusable="true"

                        android:foreground="?attr/selectableItemBackground"

                        app:cardBackgroundColor="#F0EAF4"

                        app:cardCornerRadius="28dp"

                        app:cardElevation="8dp"

                        app:strokeColor="#D8CEDD"

                        app:strokeWidth="1dp">


                        <LinearLayout

                            android:layout_width="match_parent"
                            android:layout_height="match_parent"

                            android:gravity="center"

                            android:orientation="vertical">


                            <ImageView

                                android:layout_width="70dp"
                                android:layout_height="70dp"

                                android:src="@drawable/approved"

                                android:scaleType="centerInside"

                                android:contentDescription="Approved" />


                            <TextView

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="14dp"

                                android:text="Approved"

                                android:textColor="#4E4A50"

                                android:textSize="22sp"

                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- Rejected -->

                    <com.google.android.material.card.MaterialCardView

                        android:id="@+id/cardRejectedAction"

                        android:layout_width="0dp"
                        android:layout_height="190dp"

                        android:layout_weight="1"

                        android:layout_marginStart="10dp"

                        android:clickable="true"
                        android:focusable="true"

                        android:foreground="?attr/selectableItemBackground"

                        app:cardBackgroundColor="#F0EAF4"

                        app:cardCornerRadius="28dp"

                        app:cardElevation="8dp"

                        app:strokeColor="#D8CEDD"

                        app:strokeWidth="1dp">


                        <LinearLayout

                            android:layout_width="match_parent"
                            android:layout_height="match_parent"

                            android:gravity="center"

                            android:orientation="vertical">


                            <ImageView

                                android:layout_width="70dp"
                                android:layout_height="70dp"

                                android:src="@drawable/rejected"

                                android:scaleType="centerInside"

                                android:contentDescription="Rejected" />


                            <TextView

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="14dp"

                                android:text="Rejected"

                                android:textColor="#4E4A50"

                                android:textSize="22sp"

                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>


                <!-- ============================= -->
                <!-- ROW 3 -->
                <!-- ============================= -->

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="22dp"

                    android:orientation="horizontal">


                    <!-- Profile -->

                    <com.google.android.material.card.MaterialCardView

                        android:id="@+id/cardProfile"

                        android:layout_width="0dp"
                        android:layout_height="190dp"

                        android:layout_weight="1"

                        android:layout_marginEnd="10dp"

                        android:clickable="true"
                        android:focusable="true"

                        android:foreground="?attr/selectableItemBackground"

                        app:cardBackgroundColor="#F0EAF4"

                        app:cardCornerRadius="28dp"

                        app:cardElevation="8dp"

                        app:strokeColor="#D8CEDD"

                        app:strokeWidth="1dp">


                        <LinearLayout

                            android:layout_width="match_parent"
                            android:layout_height="match_parent"

                            android:gravity="center"

                            android:orientation="vertical">


                            <ImageView

                                android:layout_width="70dp"
                                android:layout_height="70dp"

                                android:src="@drawable/profile"

                                android:scaleType="centerInside"

                                android:contentDescription="My Profile" />


                            <TextView

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="14dp"

                                android:text="My Profile"

                                android:textColor="#4E4A50"

                                android:textSize="22sp"

                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>


            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ============================= -->
    <!-- LOGOUT BUTTON -->
    <!-- ============================= -->

    <com.google.android.material.button.MaterialButton

        android:id="@+id/btnLogout"

        android:layout_width="0dp"

        android:layout_height="64dp"

        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"

        android:text="Logout"

        android:textColor="@android:color/white"

        android:textSize="21sp"

        android:textStyle="bold"

        android:gravity="center"

        android:insetTop="0dp"
        android:insetBottom="0dp"

        app:backgroundTint="#6A4FB3"

        app:cornerRadius="25dp"

        app:elevation="5dp"

        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>